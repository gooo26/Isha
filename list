function doGet() {
  return ContentService.createTextOutput(JSON.stringify(getSheetData()))
    .setMimeType(ContentService.MimeType.JSON);
}

function getSheetData() {
  try {
    var sheet = SpreadsheetApp.getActiveSpreadsheet().getActiveSheet();
    var data = sheet.getDataRange().getValues();
    
    if (data.length <= 1) {
      return { success: true, placements: [], total: 0 };
    }
    
    var placements = [];
    var headers = data[0];
    
    // Find column indices - matching your headers
    var srIndex = headers.indexOf("Sr. No.");
    var companyIndex = headers.indexOf("Company");
    var salaryIndex = headers.indexOf("Salary Package");
    var tradeIndex = headers.indexOf("Trade");
    var locationIndex = headers.indexOf("Location");
    var dateIndex = headers.indexOf("Date");
    
    // If not found, try alternative names
    if (srIndex === -1) srIndex = headers.indexOf("s.r");
    if (companyIndex === -1) companyIndex = headers.indexOf("COMPANY");
    if (salaryIndex === -1) salaryIndex = headers.indexOf("Salary");
    if (tradeIndex === -1) tradeIndex = headers.indexOf("trade");
    if (locationIndex === -1) locationIndex = headers.indexOf("location");
    if (dateIndex === -1) dateIndex = headers.indexOf("date");
    
    // Process each row
    for (var i = 1; i < data.length; i++) {
      var row = data[i];
      
      // Skip empty rows
      if (!row[companyIndex] || row[companyIndex].toString().trim() === "") {
        continue;
      }
      
      placements.push({
        srNo: row[srIndex] || i,
        company: row[companyIndex] || "",
        salary: row[salaryIndex] || "Not Disclosed",
        trade: row[tradeIndex] || "All Trades",
        location: row[locationIndex] || "TBD",
        date: formatDate(row[dateIndex])
      });
    }
    
    return {
      success: true,
      placements: placements,
      total: placements.length,
      lastUpdated: new Date().toLocaleString()
    };
    
  } catch (error) {
    return {
      success: false,
      error: error.toString(),
      placements: [],
      total: 0
    };
  }
}

function formatDate(dateValue) {
  if (!dateValue) return "Date TBA";
  
  try {
    if (dateValue instanceof Date) {
      return dateValue.toLocaleDateString('en-IN');
    }
    var date = new Date(dateValue);
    if (!isNaN(date.getTime())) {
      return date.toLocaleDateString('en-IN');
    }
    return dateValue.toString();
  } catch (e) {
    return dateValue.toString();
  }
}